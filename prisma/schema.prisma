// Momentum — Agentic Micro-Economy schema (SQLite version with enums)

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────────────────────
// No login/account system yet — every task is currently attributed to a
// single demo user (see lib/db/demoUser.ts) so chat history has a stable
// owner to scope by once real auth lands.

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
}

// ─────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum WalletType {
  MANAGER
  AGENT
  USER
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum TaskStatus {
  CREATED
  PLANNING
  IN_PROGRESS
  AWAITING_QA
  COMPLETED
  FAILED
  CANCELLING
  CANCELLED
}

enum SubtaskStatus {
  PENDING
  BIDDING
  ASSIGNED
  EXECUTING
  AWAITING_QA
  DONE
  FAILED
}

enum EscrowStatus {
  LOCKED
  RELEASED
  REFUNDED
}

enum TxType {
  LOCK
  PAYOUT
  REFUND
  BLOCKED_ATTEMPT
}

enum TxStatus {
  APPROVED
  BLOCKED
}

// ─────────────────────────────────────────────────────────────────────────
// WALLETS
// ─────────────────────────────────────────────────────────────────────────

model Wallet {
  id              String     @id @default(cuid())
  type            WalletType
  agentId         String?    @unique
  agent           Agent?     @relation(fields: [agentId], references: [id])
  balance         Int        @default(0)
  algorandAddress String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  centralLedgerFrom CentralLedger[] @relation("CentralLedgerFrom")
  centralLedgerTo   CentralLedger[] @relation("CentralLedgerTo")
}

// ─────────────────────────────────────────────────────────────────────────
// AGENT REGISTRY
// ─────────────────────────────────────────────────────────────────────────

model Agent {
  id           String      @id @default(cuid())
  name         String
  capabilities String      // JSON-encoded string[]
  price        Int
  endpoint     String?
  status       AgentStatus @default(ACTIVE)
  isSeeded     Boolean     @default(true)

  // cached reputation stats, recomputed by ReputationService
  totalJobs    Int      @default(0)
  successCount Int      @default(0)
  successRate  Float    @default(0)
  avgQuality   Float    @default(0)
  avgLatencyMs Float    @default(0)
  avgCost      Float    @default(0)
  reputation   Float    @default(50)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallet         Wallet?
  bids           Bid[]
  subtasks       Subtask[]
  agentEscrows   AgentEscrow[]
  agentLedger    AgentLedger[]
  performances   AgentPerformance[]
  securityEvents SecurityEvent[]
}

// ─────────────────────────────────────────────────────────────────────────
// TASKS / SUBTASKS / BIDS
// ─────────────────────────────────────────────────────────────────────────

model Task {
  id               String     @id @default(cuid())
  prompt           String
  budget           Int
  remainingBudget  Int
  qualityThreshold Int        @default(70)
  deadline         DateTime?
  status           TaskStatus @default(CREATED)
  managerId        String     @default("manager-agent")
  finalOutput      String?    // JSON-encoded final output payload
  userId           String     @default("demo-user")
  user             User       @relation(fields: [userId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  subtasks       Subtask[]
  centralEscrow  CentralEscrow?
  centralLedger  CentralLedger[]
  agentEscrows   AgentEscrow[]
  agentLedger    AgentLedger[]
  events         Event[]
  performances   AgentPerformance[]
  securityEvents SecurityEvent[]
  algorandTransactions AlgorandLedgerTransaction[]

  @@index([userId])
}

model Subtask {
  id                 String        @id @default(cuid())
  taskId             String
  task               Task          @relation(fields: [taskId], references: [id])
  type               String
  requiredCapability String
  status             SubtaskStatus @default(PENDING)
  sequence           Int           @default(0)
  dependsOn          String        @default("[]") // JSON-encoded string[] of subtask ids
  assignedAgentId    String?
  assignedAgent      Agent?        @relation(fields: [assignedAgentId], references: [id])
  attemptCount       Int           @default(0)
  maxAttempts        Int           @default(2)
  output             String?       // JSON-encoded worker output
  qaScore            Int?
  qaReason           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  bids         Bid[]
  agentEscrows AgentEscrow[]
  agentLedger  AgentLedger[]
  performances AgentPerformance[]
}

model Bid {
  id          String   @id @default(cuid())
  subtaskId   String
  subtask     Subtask  @relation(fields: [subtaskId], references: [id])
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id])
  amount      Int
  proposal    String
  submittedAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// ECONOMY — two-tier escrow + ledger
// ─────────────────────────────────────────────────────────────────────────

model CentralEscrow {
  id            String   @id @default(cuid())
  taskId        String   @unique
  task          Task     @relation(fields: [taskId], references: [id])
  totalLocked   Int      @default(0)
  totalReleased Int      @default(0)
  totalRefunded Int      @default(0)
  status        String   @default("ACTIVE") // ACTIVE | CLOSED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AgentEscrow {
  id        String       @id @default(cuid())
  taskId    String
  task      Task         @relation(fields: [taskId], references: [id])
  subtaskId String
  subtask   Subtask      @relation(fields: [subtaskId], references: [id])
  agentId   String
  agent     Agent        @relation(fields: [agentId], references: [id])
  amount    Int
  status    EscrowStatus @default(LOCKED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  centralLedger CentralLedger[]
  agentLedger   AgentLedger[]
}

model CentralLedger {
  id            String       @id @default(cuid())
  taskId        String
  task          Task         @relation(fields: [taskId], references: [id])
  agentEscrowId String?
  agentEscrow   AgentEscrow? @relation(fields: [agentEscrowId], references: [id])
  fromWalletId  String
  fromWallet    Wallet       @relation("CentralLedgerFrom", fields: [fromWalletId], references: [id])
  toWalletId    String
  toWallet      Wallet       @relation("CentralLedgerTo", fields: [toWalletId], references: [id])
  amount        Int
  currency      String       @default("VIRTUAL_TOKEN")
  purpose       String
  type          TxType
  status        TxStatus
  reason        String?
  timestamp     DateTime     @default(now())

  agentLedger        AgentLedger[]
  algorandTransaction AlgorandLedgerTransaction?
}

model AgentLedger {
  id              String         @id @default(cuid())
  agentId         String
  agent           Agent          @relation(fields: [agentId], references: [id])
  taskId          String
  task            Task           @relation(fields: [taskId], references: [id])
  subtaskId       String?
  subtask         Subtask?       @relation(fields: [subtaskId], references: [id])
  agentEscrowId   String?
  agentEscrow     AgentEscrow?   @relation(fields: [agentEscrowId], references: [id])
  centralLedgerId String?
  centralLedger   CentralLedger? @relation(fields: [centralLedgerId], references: [id])
  direction       String         // CREDIT | DEBIT | BLOCKED
  amount          Int
  purpose         String
  type            TxType
  status          TxStatus
  reason          String?
  timestamp       DateTime       @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// PERFORMANCE / REPUTATION / WORKFLOW MEMORY
// ─────────────────────────────────────────────────────────────────────────

model AgentPerformance {
  id                String   @id @default(cuid())
  agentId           String
  agent             Agent    @relation(fields: [agentId], references: [id])
  taskId            String
  task              Task     @relation(fields: [taskId], references: [id])
  subtaskId         String
  subtask           Subtask  @relation(fields: [subtaskId], references: [id])
  taskType          String
  capabilities      String   // JSON-encoded string[]
  expectedCost      Int
  actualCost        Int
  expectedLatencyMs Int
  actualLatencyMs   Int
  qaScore           Int
  success           Boolean
  createdAt         DateTime @default(now())
}

model WorkflowMemory {
  id           String   @id @default(cuid())
  taskType     String
  taskFeatures String   // JSON-encoded feature vector/keywords
  subtasks     String   // JSON-encoded subtask type list
  agentsUsed   String   // JSON-encoded agent ids
  sequence     String   // JSON-encoded execution order
  dependencies String   // JSON-encoded dependency map
  cost         Int
  latencyMs    Int
  quality      Float
  success      Boolean
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// EVENTS / SECURITY / PAYMENTS
// ─────────────────────────────────────────────────────────────────────────

model Event {
  id        String   @id @default(cuid())
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  actor     String   // manager | <agentId> | qa | circuit_breaker | system
  eventType String
  payload   String   // JSON-encoded
  createdAt DateTime @default(now())
}

model SecurityEvent {
  id              String   @id @default(cuid())
  taskId          String?
  task            Task?    @relation(fields: [taskId], references: [id])
  agentId         String?
  agent           Agent?   @relation(fields: [agentId], references: [id])
  type            String
  reason          String
  payload         String   // JSON-encoded
  createdAt       DateTime @default(now())
  severity        String?
  requestedAmount Float?
  allowedAmount   Float?
  metadata        String?  // JSON-encoded optional metadata
}

model PaymentIntent {
  id                 String    @id @default(cuid())
  taskId             String
  requestingAgentId  String
  recipientServiceId String
  amount             Float
  currency           String    // e.g. "USDC", "ETH"
  status             String    // PENDING, SETTLED, FAILED, BLOCKED
  idempotencyKey     String    @unique
  blockchainTxId     String?
  network            String?   // e.g. "sepolia"
  failureReason      String?
  createdAt          DateTime  @default(now())
  settledAt          DateTime?
}

model BlockchainTransaction {
  id              String    @id @default(cuid())
  paymentIntentId String
  network         String
  transactionId   String    @unique
  amount          Float
  asset           String
  status          String
  confirmedAt     DateTime?
  rawMetadata     String?   // JSON-encoded optional metadata
}

// Mirrors internal virtual-token wallet-to-wallet transfers (escrow lock,
// payout to a worker agent, refund) onto the Algorand testnet so every
// agent-to-agent payment has a corresponding on-chain transaction the judge
// can inspect. The internal ledger (CentralLedger/AgentLedger) stays the
// source of truth; this table is a settlement mirror, not authoritative.
model AlgorandLedgerTransaction {
  id              String         @id @default(cuid())
  taskId          String?
  task            Task?          @relation(fields: [taskId], references: [id])
  centralLedgerId String?        @unique
  centralLedger   CentralLedger? @relation(fields: [centralLedgerId], references: [id])
  fromWalletId    String
  toWalletId      String
  fromAddress     String
  toAddress       String
  amount          Int
  purpose         String
  type            TxType
  txId            String         @unique
  network         String
  status          String         // CONFIRMED | FAILED
  createdAt       DateTime       @default(now())
}

model BlockchainWorkflowEvent {
  id                      String    @id @default(cuid())
  workflowId              String
  taskId                  String?
  eventType               String    // TASK_ASSIGNED | RESULT_COMMITTED | RESULT_VERIFIED | QA_APPROVED | etc.
  fromAgentId             String?
  toAgentId               String?
  payloadHash             String
  canonicalPayloadVersion Int       @default(1)
  network                 String
  transactionId           String?
  status                  String    // PENDING | SUBMITTED | CONFIRMED | FAILED | SKIPPED
  failureReason           String?
  createdAt               DateTime  @default(now())
  confirmedAt             DateTime?
}
